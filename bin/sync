#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname $0)/.." || exit 1

env_prefix=''

if [ "${1:-}" = 'staging' ]; then
  env_prefix='Staging'
fi

aws_region=$(perl -ne '/region\s*=\s*"(.+?)"/ && print $1' < samconfig.toml)
stack_name=$(perl -ne '/stack_name\s*=\s*"(.+?)"/ && print $1' < samconfig.toml)
resource_ids=$(aws cloudformation describe-stack-resources \
  --region "$aws_region" \
  --stack-name "$stack_name" \
  --query "StackResources[?LogicalResourceId == '${env_prefix}Bucket' || LogicalResourceId == '${env_prefix}Distribution'].PhysicalResourceId" \
  --output text)
bucket_name=$(echo "$resource_ids" | cut -f 1)
distribution_id=$(echo "$resource_ids" | cut -f 2)

aws s3 sync \
  --include '*' \
  --exclude '.DS_Store' \
  --exclude '*/.DS_Store' \
  --exclude '.gitignore' \
  --exclude '*/.gitignore' \
  'dist' \
  "s3://$bucket_name/"

aws cloudfront create-invalidation \
  --distribution-id "$distribution_id" \
  --paths '/*'
